{
  "name": "worktree-manager",
  "version": "0.2.0",
  "description": "Mouse-friendly Git worktree and development server TUI",
  "type": "module",
  "private": true,
  "bin": {
    "wt": "bin/wt"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "dev:watch": "bun --watch src/cli.ts",
    "start": "bun dist/cli.js",
    "build": "bun build src/cli.ts src/supervisor.ts --target=bun --packages=external --sourcemap=linked --outdir=dist",
    "build:watch": "bun run build --watch --no-clear-screen",
    "build:bin": "bun scripts/build-binary.ts",
    "preview": "bun run build && bun run start",
    "preview:bin": "bun run build:bin && ./dist/wt",
    "verify:build": "bun run build && bun run build:bin && bun scripts/verify-build.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome check src tests scripts package.json tsconfig.json biome.json",
    "format": "biome check --write src tests scripts package.json tsconfig.json biome.json",
    "test": "bun test --timeout 20000"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@opentui/core": "0.5.10",
    "commander": "^14.0.0",
    "proper-lockfile": "^4.1.2",
    "shell-quote": "^1.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.3.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/shell-quote": "^1.7.5",
    "typescript": "^5.9.0"
  }
}
